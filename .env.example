# ============================================================
# Fundraiser Food Math — Environment Variables
#
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ============================================================

# ── Stripe (required for future secure webhook verification) ──
# Not required for the current MVP client-side unlock flow.
# See artifacts/api-server/src/routes/stripe.ts for the future flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── App ──────────────────────────────────────────────────────
# Your deployed domain (used for og:image absolute URLs, redirect validation, etc.)
APP_BASE_URL=

# ── Support ──────────────────────────────────────────────────
# Must match SUPPORT_EMAIL in artifacts/fundraiser-food-math/src/config/paymentLinks.ts
SUPPORT_EMAIL=
